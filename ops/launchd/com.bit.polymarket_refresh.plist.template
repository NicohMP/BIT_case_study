<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.bit.polymarket_refresh</string>

    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/zsh</string>
      <string>-lc</string>
      <string>mkdir -p logs &amp;&amp; cd "__REPO_ROOT__" &amp;&amp; set -a &amp;&amp; source .env &amp;&amp; set +a &amp;&amp; "__PYTHON__" scripts/run_polymarket_refresh.py --ingest-max-pages 200 --matcher-version matcher_v10 --scoring-version relevance_v5 --persist-selection true --selection-version selected_v1 --record-daily-snapshots false --run-audit false</string>
    </array>

    <key>StartInterval</key>
    <integer>7200</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__REPO_ROOT__/logs/polymarket_refresh.out.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO_ROOT__/logs/polymarket_refresh.err.log</string>
  </dict>
</plist>
