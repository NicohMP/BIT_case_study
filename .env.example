# Environment variables for Polymarket Signal Scanner.
#
# Notes:
# - Only `DATABASE_URL` is required for Steps 1–4b.
# - LLM variables are required only for Step 5 report generation.

# Database (required)
# Supabase local Postgres is typically on 127.0.0.1:54322.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Polymarket Gamma API (optional)
POLYMARKET_API_BASE_URL=https://gamma-api.polymarket.com

# Embeddings (optional; used when embeddings are enabled in Step 3 discovery)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DEVICE=cpu   # safe default
# EMBEDDING_DEVICE=mps   # macOS (Apple Silicon)
# EMBEDDING_DEVICE=cuda  # Linux/NVIDIA (requires CUDA-enabled PyTorch)

# LLM backend (optional; Step 5 only)
# Supported: gemini | ollama
LLM_BACKEND=gemini

# Gemini (hosted)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Fallback env var names (also accepted by `polyscanner/llm/gemini.py`)
LLM_API_KEY=
LLM_MODEL=

# Ollama (local; only used if LLM_BACKEND=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
