# Environment variables for the Polymarket scanning pipeline.

# Polymarket
POLYMARKET_API_BASE_URL=https://gamma-api.polymarket.com

# Database (Supabase local Postgres is typically on 127.0.0.1:54322)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional LLM enrichment (not required for Steps 1–3)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional fallbacks (accepted by `polyscanner/llm/gemini.py`)
LLM_API_KEY=
LLM_MODEL=

# Optional: label your Step 3 output version (used by some report helpers)
MATCHER_VERSION=matcher_v1

# Optional embeddings (Step 3 discovery)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=mps
