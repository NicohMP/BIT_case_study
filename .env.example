# Environment variables for the MVP pipeline.

# Polymarket
POLYMARKET_API_BASE_URL=

# Database (Supabase local Postgres is typically on 127.0.0.1:54322)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Gemini (Google AI Studio)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional fallbacks (accepted by `polyscanner/llm_gemini.py`)
LLM_API_KEY=
LLM_MODEL=
